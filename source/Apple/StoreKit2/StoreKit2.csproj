<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <NoBindingEmbedding>true</NoBindingEmbedding>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <RootNamespace>StoreKit2</RootNamespace>
    <AssemblyName>StoreKit2</AssemblyName>
    <AssemblyVersion>11.0.0.0</AssemblyVersion>
    <FileVersion>11.0.0.0</FileVersion>
    <IPhoneResourcePrefix>Resources</IPhoneResourcePrefix>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageVersion>11.0.0-local</PackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PackageVersion>11.0.0.0</PackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>plugin.howitzergames.storekit2</PackageId>
    <Title>StoreKit API Library</Title>
    <Summary>C# bindings for Apple StoreKit APIs Library for .net maui implementation.</Summary>
    <Description>C# bindings for Apple StoreKit APIs Library. Not affiliated with or endorsed by Microsoft or Apple.</Description>
    <PackageTags>maui;storekit;apple;inappbilling;iap;in-app-purchase;ios;maccatalyst</PackageTags>
    <Authors>Ian Howard, Howitzer Games, LLC</Authors>
    <Owners>Ian Howard, Howitzer Games, LLC</Owners>
    <Copyright>© 2025, Ian Howard, Howizer Games, LLC</Copyright>
    <PackageProjectUrl>https://github.com/howitzergamesllc/plugin.howitzergames.storekit2</PackageProjectUrl>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/howitzergamesllc/plugin.howitzergames.storekit2</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageIcon>StoreKit2Icon.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackOnBuild>true</PackOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="sharpie\ApiDefinitionsRaw.md" Pack="False"/>
    <None Include="sharpie\StructsAndEnumsRaw.md" Pack="False"/>
    <None Include="External-Dependency-Info.txt" Pack="True" PackagePath="THIRD-PARTY-NOTICES.txt" />
    <None Include="..\..\..\art\StoreKit2Icon.png" Pack="True" PackagePath="StoreKit2Icon.png" />
    <None Include="..\..\..\License.md" Pack="True" PackagePath="License.md" />
    <None Include="..\..\..\Readme.md" Pack="True" PackagePath="Readme.md"/>
  </ItemGroup>
  <ItemGroup>
    <None Include="StoreKit2.targets" Pack="True" PackagePath="build/plugin.howitzergames.storekit2.targets" />
    <None Include="StoreKit2.targets" Pack="True" PackagePath="buildTransitive/plugin.howitzergames.storekit2.targets" />
  </ItemGroup>
  <ItemGroup>
    <NativeReference Include="..\..\..\externals\StoreKit2.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>True</SmartLink>
      <ForceLoad>True</ForceLoad>
      <Frameworks>Foundation UIKit</Frameworks>
    </NativeReference>
  </ItemGroup>
  <ItemGroup>
    <ObjcBindingCoreSource Include="Enums.cs" />
    <ObjcBindingApiDefinition Include="ApiDefinitions.cs" />
  </ItemGroup>
</Project>
